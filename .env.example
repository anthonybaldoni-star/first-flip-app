# Supabase (public anon key only in the client — never service_role)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Stripe Checkout URL from your backend after creating a session for the user
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=

# Dev-only: simulate tier for UI (never set in production builds)
# EXPO_PUBLIC_DEV_TIER=pro

# Edge function / server secrets (not bundled in the app)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
